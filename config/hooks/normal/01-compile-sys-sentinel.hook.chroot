#!/bin/bash
set -euo pipefail

echo "[HOOK] Compiling sys-sentinel from sources..."
SRC_DIR="/tmp/src/sys-sentinel"

if [ ! -d "${SRC_DIR}" ]; then
    echo "[HOOK ERROR] Source directory ${SRC_DIR} not found!"
    exit 1
fi

cd "${SRC_DIR}"
make -j"$(nproc)"
make install
make clean

echo "[HOOK] Removing sources and purge temporary build dependencies..."
rm -rf /tmp/src

DEBIAN_FRONTEND=noninteractive apt-get purge -y --auto-remove g++ make
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "[HOOK] Compilation and cleanup finished."
