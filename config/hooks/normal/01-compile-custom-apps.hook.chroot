#!/bin/bash
set -euo pipefail

echo "[HOOK] Compiling native Humanix components from sources..."

if [ -d "/tmp/src/sys-sentinel" ]; then
    echo "  -> Building sys-sentinel & sentinel-ctl..."
    cd /tmp/src/sys-sentinel
    make -j"$(nproc)" install clean || {
        g++ -O2 -Wall -Wextra -std=c++17 main.cpp -o /usr/local/bin/sys-sentinel
        g++ -O2 -Wall -Wextra -std=c++17 sentinel-ctl.cpp -o /usr/local/bin/sentinel-ctl
    }
fi

if [ -d "/tmp/src/dish" ]; then
    echo "  -> Building dish (Humanix Shell)..."
    cd /tmp/src/dish
    make -j"$(nproc)" install clean || {
        echo "  [WARN] Makefile failed, using fallback direct compilation..."
        g++ -O2 -Wall -Wextra -std=c++17 main.cpp -o /usr/local/bin/dish
    }
    
    if ! grep -qx "/usr/local/bin/dish" /etc/shells; then
        echo "/usr/local/bin/dish" >> /etc/shells
    fi
fi

if [ -d "/tmp/src/humanix-fetch" ]; then
    echo "  -> Building humanix-fetch..."
    cd /tmp/src/humanix-fetch
    make -j"$(nproc)" install clean || {
        g++ -O2 -Wall -Wextra -std=c++17 main.cpp -o /usr/local/bin/humanix-fetch
    }
fi

if [ -d "/tmp/src/humanix-installer" ]; then
    echo "  -> Building humanix-installer..."
    cd /tmp/src/humanix-installer
    make -j"$(nproc)" install clean || {
        g++ -O2 -Wall -Wextra -std=c++17 main.cpp -o /usr/local/sbin/humanix-installer
    }
fi

echo "[HOOK] Purging sources and temporary build toolchain..."
rm -rf /tmp/src
DEBIAN_FRONTEND=noninteractive apt-get purge -y --auto-remove g++ make
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "[HOOK] All native Humanix components built and installed successfully."
