#!/bin/bash
set -euo pipefail

echo "[HOOK] Configuring Humanix runtime, NetworkManager and user groups..."

SHELL_BIN="/usr/local/bin/dish"
FALLBACK_SHELL="/bin/bash"

TARGET_SHELL="${FALLBACK_SHELL}"
if [ -x "${SHELL_BIN}" ]; then
    TARGET_SHELL="${SHELL_BIN}"
fi

if ! id -u humanix >/dev/null 2>&1; then
    useradd -m -s "${TARGET_SHELL}" -u 1000 -U humanix
    passwd -d humanix
    usermod -aG sudo,audio,video,netdev humanix
else
    chsh -s "${TARGET_SHELL}" humanix
    usermod -aG netdev humanix
fi

chsh -s "${TARGET_SHELL}" root

echo "humanix ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/01-humanix-user
chmod 0440 /etc/sudoers.d/01-humanix-user

systemctl enable NetworkManager.service
systemctl enable sys-sentinel.service

systemctl disable systemd-networkd.service || true
systemctl mask systemd-networkd.service || true
systemctl mask systemd-networkd-wait-online.service || true
systemctl mask apt-daily.service apt-daily.timer apt-daily-upgrade.service apt-daily-upgrade.timer || true

echo "[HOOK] Humanix runtime configured cleanly."
