#!/bin/bash
set -euo pipefail

echo "[HOOK] Configuring Humanix runtime environment..."

SHELL_BIN="/usr/local/bin/dish"
FALLBACK_SHELL="/bin/bash"

TARGET_SHELL="${FALLBACK_SHELL}"
if [ -x "${SHELL_BIN}" ]; then
    TARGET_SHELL="${SHELL_BIN}"
fi

# Создаем пользователя humanix с дефолтным шеллом dish
if ! id -u humanix >/dev/null 2>&1; then
    useradd -m -s "${TARGET_SHELL}" -u 1000 -U humanix
    passwd -d humanix
    usermod -aG sudo,audio,video humanix
else
    chsh -s "${TARGET_SHELL}" humanix
fi

# Для root также выставляем dish при интерактивном входе
chsh -s "${TARGET_SHELL}" root

# Sudoers NOPASSWD
echo "humanix ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/01-humanix-user
chmod 0440 /etc/sudoers.d/01-humanix-user

# Включаем сетевые службы и демон телеметрии
systemctl enable systemd-networkd.service
systemctl enable systemd-resolved.service
systemctl enable sys-sentinel.service

# DNS stub
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

echo "[HOOK] Runtime environment configured with shell: ${TARGET_SHELL}"
