#!/bin/bash
set -euo pipefail

echo "[HOOK] Creating canonical /live/vmlinuz and /live/initrd.img links..."

# Определяем путь к каталогу live относительно текущей директории исполнения
if [ -d "live" ]; then
    LIVE_DIR="live"
elif [ -d "binary/live" ]; then
    LIVE_DIR="binary/live"
else
    echo "[HOOK ERROR] Cannot find live/ directory from $(pwd)"
    exit 1
fi

cd "${LIVE_DIR}"

# Находим первое версионное ядро, исключая уже созданные симлинки/хардлинки
KERNEL=$(ls vmlinuz-* 2>/dev/null | grep -Ev '^(vmlinuz|vmlinuz\.tmp)$' | head -n 1 || true)
INITRD=$(ls initrd.img-* 2>/dev/null | grep -Ev '^(initrd\.img|initrd\.img\.tmp)$' | head -n 1 || true)

if [ -z "${KERNEL}" ] || [ -z "${INITRD}" ]; then
    echo "[HOOK ERROR] Versioned kernel or initrd is missing in ${PWD}"
    exit 1
fi

if [ -e vmlinuz ] && [ "${KERNEL}" -ef vmlinuz ]; then
    echo "[HOOK] vmlinuz is already canonically linked to ${KERNEL}"
else
    ln -f -- "${KERNEL}" vmlinuz || cp -f -- "${KERNEL}" vmlinuz
fi

if [ -e initrd.img ] && [ "${INITRD}" -ef initrd.img ]; then
    echo "[HOOK] initrd.img is already canonically linked to ${INITRD}"
else
    ln -f -- "${INITRD}" initrd.img || cp -f -- "${INITRD}" initrd.img
fi

test -s vmlinuz && test -s initrd.img

echo "[HOOK] Canonical kernel files verified:"
ls -lh vmlinuz initrd.img
